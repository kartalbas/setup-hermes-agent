# shellcheck shell=bash disable=SC2034
#
# Template. Copy to the name without .example and fill in the blanks;
# that copy is gitignored.
# Secrets are referenced by variable NAME only; values live in SECRETS_FILE.

# =============================================================================
#  SITE VALUES — fill these in. Everything else below has a working default.
#
#  Credentials are NOT here; they live in the file named by SECRETS_FILE at the
#  bottom of this file. Editing that one file plus these two blocks is the whole
#  job.
# =============================================================================

# IANA timezone. Scheduled reports and calendar invitations are generated in
# this zone, so getting it wrong produces appointments at the wrong hour and the
# symptom shows up far from the cause.
TIMEZONE="Europe/Zurich"

# The public name Microsoft Teams will post to, and the DNS zone containing it.
# The hostname does not need to exist yet — the run creates the record.
#   TUNNEL_HOSTNAME="hermes.your-zone.example"
#   TUNNEL_ZONE="your-zone.example"
TUNNEL_HOSTNAME=""
TUNNEL_ZONE=""

# =============================================================================

# --- target -------------------------------------------------------------
# TIMEZONE is set in the SITE VALUES block at the top of this file.

FIREWALL_MANAGE=true
FIREWALL_ALLOW_PORTS="22"

# --- service ------------------------------------------------------------
SERVICE_SCOPE="system"
SERVICE_NAME="hermes-gateway"
SERVICE_HARDEN_NO_NEW_PRIVS=true
SERVICE_START_LIMIT_INTERVAL=600
SERVICE_START_LIMIT_BURST=20
SERVICE_WATCHDOG_SECONDS=90
JOURNAL_MAX_USE="1G"

HERMES_HOME=""

# --- upstream -----------------------------------------------------------
HERMES_REF="v2026.8.31"
HERMES_REF_KIND="tag"
HERMES_SKIP_BROWSER=true
HERMES_SKIP_SKILLS=false

# --- inference ----------------------------------------------------------
# One endpoint: the local bridge. It is loopback, so it needs no credential —
# the subscription lives in the CLI behind it, signed in as the service account.
LLM_ENDPOINT_COUNT=1
LLM_STRATEGY="single"

LLM_ENDPOINT_1_PROVIDER="custom"
LLM_ENDPOINT_1_NAME="bridge"
LLM_ENDPOINT_1_BASE_URL=""
LLM_ENDPOINT_1_MODEL="gemini-3.8-flash-high"
LLM_ENDPOINT_1_TOKEN_VAR=""

# Left at the endpoint's own defaults: the previous values were tuned to a
# self-hosted model that no longer exists.
LLM_CONTEXT_WINDOW=0
LLM_MAX_OUTPUT=0
LLM_REASONING_FIELD=""
LLM_VERIFY_TOKEN=true

# --- mail relay ---------------------------------------------------------
# A local OAuth2 IMAP/SMTP relay in front of a corporate mailbox. Microsoft 365
# disables IMAP basic authentication tenant-wide and it cannot be re-enabled, so
# an M365 mailbox is unreachable without this — the adapter speaks plain
# IMAP/SMTP to loopback and the relay holds the OAuth token.
#
# Only needed when CHANNEL_EMAIL_ACCOUNT="work". With it on, the run redirects
# the work mailbox's hosts to loopback by itself; leave the real hosts in
# channels.conf.
MAILPROXY_ENABLED=true

# device = you approve a sign-in once in a browser, the relay refreshes from
#          then on. Works with a delegated app registration and no admin.
# client  = client credentials; unattended from the start, but needs an admin
#          to grant application permissions on the tenant.
MAILPROXY_FLOW="device"          # device|client

# --- the bridge ---------------------------------------------------------
AGY_SHIM_ENABLED=true
AGY_SHIM_BINARY="agy"
AGY_SHIM_HOST="127.0.0.1"
AGY_SHIM_PORT=8787

# The allowlist IS the control. The caller decides when to escalate; it does
# not get to decide what to escalate to, and it cannot drop to a cheaper tier.
AGY_SHIM_MODELS="gemini-3.8-flash-high,gemini-3.1-pro-high"
AGY_SHIM_MODEL_ALIASES="fast=gemini-3.8-flash-high,smart=gemini-3.1-pro-high"
AGY_SHIM_UNKNOWN_MODEL="reject"

# Measured: ~239 MB per live conversation. Six is what 7 GB tolerates next to
# everything else on this host.
AGY_SHIM_MAX_PROCESSES=6
AGY_SHIM_MAX_CONCURRENT=3
AGY_SHIM_IDLE_TIMEOUT=900
AGY_SHIM_COMPACT_AT=120000

# --- hosted providers, prepared but not active --------------------------
# Raise LLM_ENDPOINT_COUNT and uncomment a block to bring one in. A hosted
# provider takes no base_url — it is identified by name — and the key goes in
# SECRETS_FILE under the variable named here. Position decides the role:
# slot 1 is the model in use, later slots are the fallback chain in order.
#
# Nothing here needs a key until you decide to use it: a slot whose key is
# missing is skipped with a note rather than failing the run.
#
#LLM_ENDPOINT_3_PROVIDER="anthropic"      # key: ANTHROPIC_API_KEY
#LLM_ENDPOINT_3_NAME="claude"
#LLM_ENDPOINT_3_MODEL="claude-opus-4"
#LLM_ENDPOINT_3_TOKEN_VAR="ANTHROPIC_API_KEY"
#
#LLM_ENDPOINT_4_PROVIDER="openai"         # key: OPENAI_API_KEY
#LLM_ENDPOINT_4_NAME="openai"
#LLM_ENDPOINT_4_MODEL="gpt-4"
#LLM_ENDPOINT_4_TOKEN_VAR="OPENAI_API_KEY"
#
#LLM_ENDPOINT_5_PROVIDER="google"         # key: GOOGLE_API_KEY
#LLM_ENDPOINT_5_NAME="gemini"
#LLM_ENDPOINT_5_MODEL="gemini-3-flash-preview"
#LLM_ENDPOINT_5_TOKEN_VAR="GOOGLE_API_KEY"
#
#LLM_ENDPOINT_6_PROVIDER="kimi-coding"    # Moonshot; key: KIMI_API_KEY
#LLM_ENDPOINT_6_NAME="kimi"
#LLM_ENDPOINT_6_MODEL="kimi-k2"
#LLM_ENDPOINT_6_TOKEN_VAR="KIMI_API_KEY"
#
#LLM_ENDPOINT_7_PROVIDER="zai"            # z.ai / GLM; key: GLM_API_KEY
#LLM_ENDPOINT_7_NAME="glm"
#LLM_ENDPOINT_7_MODEL="glm-4"
#LLM_ENDPOINT_7_TOKEN_VAR="GLM_API_KEY"
#
#LLM_ENDPOINT_8_PROVIDER="openrouter"     # aggregator; key: OPENROUTER_API_KEY
#LLM_ENDPOINT_8_NAME="openrouter"
#LLM_ENDPOINT_8_MODEL="anthropic/claude-sonnet-4"
#LLM_ENDPOINT_8_TOKEN_VAR="OPENROUTER_API_KEY"
#
#LLM_ENDPOINT_9_PROVIDER="deepseek"       # DeepSeek direct; key: DEEPSEEK_API_KEY
#LLM_ENDPOINT_9_NAME="deepseek"
#LLM_ENDPOINT_9_MODEL="deepseek-chat"     # text only (= deepseek-v4-flash); deepseek-v4-flash-vision-exp reads images too
#LLM_ENDPOINT_9_TOKEN_VAR="DEEPSEEK_API_KEY"

# --- dashboard ----------------------------------------------------------
# The agent's web UI. It holds API keys, so it binds to loopback and is never
# published directly. To reach it from another machine, the provisioner puts an
# authenticating reverse proxy in front of it on the address below.
DASHBOARD_ENABLED=true
DASHBOARD_PORT=9119                  # loopback only; not exposed
DASHBOARD_PROXY=true
DASHBOARD_PROXY_BIND=""
DASHBOARD_PROXY_PORT=80
# Basic authentication at the proxy. The dashboard enforces its own login
# whenever DASHBOARD_PROXY_BIND is non-loopback, so this is normally a second
# prompt for the same door. Turning it off is safe there and leaves one login;
# the run refuses to finish if neither layer is gating.
DASHBOARD_PROXY_AUTH=true

DASHBOARD_PROXY_USER="admin"
DASHBOARD_PROXY_PASSWORD_VAR="DASHBOARD_PASSWORD"

# --- terminal sandbox ---------------------------------------------------
# Native, not containerised: the developer tools below are installed on the
# host, and an agent executing inside a container cannot see them.
#
# The trade is explicit — there is no sandbox between the agent and this
# machine's credentials. See docs/decisions/0004.
TERMINAL_BACKEND="local"

# --- docker -------------------------------------------------------------
# Nothing needs the container runtime once the sandbox is gone.
DOCKER_MANAGE=false
DOCKER_LOG_MAX_SIZE="10m"
DOCKER_LOG_MAX_FILE=3
DOCKER_LIVE_RESTORE=true
DOCKER_ADDRESS_POOL_BASE=""
DOCKER_ADDRESS_POOL_SIZE=24

# --- inbound tunnel (Teams only) ----------------------------------------
TUNNEL_MODE="api"
TUNNEL_PROVIDER="cloudflare"
TUNNEL_NAME="hermes-agent"
# TUNNEL_HOSTNAME and TUNNEL_ZONE are in the SITE VALUES block at the top.
TUNNEL_INGRESS_TARGET="http://127.0.0.1:3978"
TUNNEL_INGRESS_PATH="/api/messages"
TUNNEL_API_TOKEN_VAR="CF_API_TOKEN"

# Transport to the Cloudflare edge. Empty lets cloudflared choose: it prefers
# QUIC over UDP/7844 and falls back to HTTP/2 over TCP/443 by itself. Set
# "http2" where UDP to the edge is degraded — the symptom is repeated
# "failed to dial to edge with quic" in the daemon's log.
TUNNEL_PROTOCOL=""                   # ""|quic|http2

# The vendor unit is Type=notify with a 15s start deadline, which is shorter
# than a QUIC-to-HTTP/2 fallback takes. This drop-in replaces it.
TUNNEL_START_TIMEOUT=90

# When the run itself switches Universal SSL on, Cloudflare still has to issue
# the edge certificate — minutes, occasionally an hour. This is how long the run
# waits for the first handshake to succeed before deferring the failure and
# finishing everything else. A re-run later completes the check.
TUNNEL_EDGE_TLS_WAIT=300
TUNNEL_ACCOUNT_ID_VAR="CF_ACCOUNT_ID"

# --- azure: the Bot Service that fronts Teams ---------------------------
# Declared in src/azure/bot.bicep and deployed with the Azure CLI, so the bot,
# its endpoint (the tunnel hostname) and its Teams channel come from this
# repository rather than from portal clicks. The two Entra app registrations
# are verified against the IDs in the secrets file, not created: creating them
# would produce a client secret that only the run has seen, and secrets flow
# from the repository to the host, never back.
#
# Requires `az login` by the operator first — a browser sign-in, like the CLI
# and the mail relay. The run installs the Azure CLI itself if it is missing.
#
# The Bot Service's msaAppId is immutable. If the existing bot carries a
# different app or tenant ID than the secrets file says, the run refuses and
# explains; set AZURE_BOT_RECREATE=true for one run to delete and recreate it
# (the Teams app then has to be added to a chat again).
AZURE_MANAGE=false
AZURE_SUBSCRIPTION_ID=""
AZURE_RESOURCE_GROUP=""
AZURE_LOCATION="westeurope"           # for the resource group; the bot itself is global
AZURE_BOT_SKU="F0"                    # F0 free | S1 paid
AZURE_BOT_RECREATE=false

# --- backup -------------------------------------------------------------
BACKUP_MANAGE=true
BACKUP_DEST=""
BACKUP_ON_CALENDAR="daily"
BACKUP_RANDOM_DELAY="1h"
BACKUP_KEEP=14

# --- git identity -------------------------------------------------------
# The agent commits as this. A shared mailbox address is fine and often better
# than a personal one — it makes agent-authored commits obvious in a log.
GIT_USER_NAME=""
GIT_USER_EMAIL=""

# Repositories owned by another account that the agent may still work in.
# Without this git refuses with "dubious ownership", which reads like a bug.
GIT_SAFE_DIRECTORIES=""

# GPG/SSH key id to sign commits with; empty disables signing.
GIT_SIGNING_KEY=""

# --- secrets ------------------------------------------------------------
# Empty means config/secrets.conf next to this file — gitignored, mode 0600.
# Point it elsewhere only if you keep credentials outside the working tree.
SECRETS_FILE=""

LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# The assistant — the agent's hands in Microsoft 365 (README 1.10). It acts as
# its own mailbox account and signs in once with a device code during the run.
# ---------------------------------------------------------------------------
ASSISTANT_M365_ENABLED=false
ASSISTANT_M365_ACCOUNT="agent@example.com"
ASSISTANT_M365_TIMEZONE="Europe/Zurich"
ASSISTANT_M365_ROOT_FOLDER="Secretary"           # the agent's working folder in its OneDrive
ASSISTANT_M365_SHARE_WITH="you@example.com"     # who gets access to it (comma-separated)
ASSISTANT_M365_SHARE_ROLE="write"
# Private and business apart: one sub-folder per world below the root folder,
# and every file name ends with the world's suffix before the extension
# (Secretary/Business/Letters/2026/2026-09-07 lease_bus.pdf). The drive tools
# refuse a path that breaks this. Empty = one undivided folder. Existing files:
# `m365ctl migrate-worlds` shows the plan, `--apply` moves them (README 1.10).
ASSISTANT_M365_WORLDS=""                         # e.g. "Business=_bus,Private=_pri"
ASSISTANT_M365_INBOX="Inbox"                     # drop folder below each world; the Secretary files what lands there (README 1.10)
# Your own mailboxes in the tenant the assistant may READ — receipts, invoices,
# letters (search, read, attachments; never send, move or mark). Comma-separated.
# Each needs Full Access delegation for ASSISTANT_M365_ACCOUNT, set once by a
# tenant admin in the Exchange admin center; the run checks and tells you (README 1.10).
ASSISTANT_M365_READ_MAILBOXES=""                 # e.g. "you@example.com"

# ---------------------------------------------------------------------------
# Bots — one per role (README 1.5). Each bot is its own Teams app and 1:1 chat,
# its own gateway service and profile (persona, memory, tools), its own
# hostname on the tunnel. A new bot is one word in BOTS plus bot/roles/<key>.md;
# the run creates its Entra app and writes the client id and secret into the
# secrets file.
# ---------------------------------------------------------------------------
BOTS="secretary search news github"
BOT_PREFIX="Acme"                      # display names: "Acme Secretary", …
TEAMS_APP_DEVELOPER="Acme"             # shown under the app name in the Teams app card (default: GIT_USER_NAME)
BOT_SERVICE_PREFIX="acme"              # units acme-<key>.service, Azure bots acme-<key>
BOT_PORT_BASE=3978
AGENT_SESSION_RESET="daily@4"          # none | daily@HOUR | idle@MINUTES; per bot: BOT_<KEY>_SESSION_RESET                     # webhook ports 3978, 3979, … (BOT_<KEY>_PORT overrides)
AGENT_TOOL_SEARCH="off"             # off: MCP tools inline (the bridge needs the real names) | auto/on: behind tool_search; per bot: BOT_<KEY>_TOOL_SEARCH

BOT_SECRETARY_CHANNELS="teams email"   # reads INBOX — everything not routed to another bot
BOT_SECRETARY_MAIL_ALIAS="secretary@example.com"
BOT_SECRETARY_MAIL_CATCH_ALL=true
# More bots on the SAME mailbox: give each an alias (added to the mailbox in
# Exchange by you); the run creates the folder and the inbox rule that sorts
# mail to the alias into it, and the bot polls that folder.
BOT_SEARCH_CHANNELS="teams email"
BOT_SEARCH_MAIL_ALIAS="search@example.com"
BOT_NEWS_CHANNELS="teams email"
BOT_NEWS_MAIL_ALIAS="news@example.com"
BOT_GITHUB_NAME="GitHub"                             # the derived default would be "Github"
BOT_GITHUB_CHANNELS="teams email"
BOT_GITHUB_MAIL_ALIAS="github@example.com"
BOT_GITHUB_MCP="github"                # the official GitHub MCP server (README 1.13)
# The Admin bot (README 1.14): state of the host, updates, and change requests
# that Claude Code turns into commits. Add "admin" to BOTS and switch on OPS_ENABLED.
# BOT_ADMIN_NAME="Admin"
# BOT_ADMIN_CHANNELS="teams"
# BOT_ADMIN_TOOLSET="terminal memory session_search clarify cronjob todo web"   # terminal for opsctl, nothing else needs it
# OPS_ENABLED=true
# OPS_CLAUDE_MODEL="opus"               # the Claude Code model for `opsctl change`
# OPS_CLAUDE_TIMEOUT=1500               # seconds one change may take
# OPS_APPLY="ask"                       # auto: apply after a green change | ask: the bot asks first | never
BOT_SECRETARY_MCP="m365"               # the Microsoft 365 assistant tools
BOT_SECRETARY_DASHBOARD=true           # the profile the dashboard shows
# A bot may run on its own model instead of the global LLM_ENDPOINT_1 — e.g. a
# real API for the bot that needs precise tool calling and images:
# BOT_SECRETARY_LLM_PROVIDER="custom"            # or anthropic, openai, …
# BOT_SECRETARY_LLM_NAME="kimi"                  # provider entry name in config.yaml
# BOT_SECRETARY_LLM_BASE_URL="https://api.example.com/v1"
# BOT_SECRETARY_LLM_MODEL="kimi-k3"
# BOT_SECRETARY_LLM_TOKEN_VAR="KIMI_API_KEY"     # name of the key in the secrets file
# BOT_SECRETARY_LLM_REASONING_FIELD="reasoning_content"   # for models that return reasoning separately
# BOT_SECRETARY_LLM_CONTEXT_WINDOW=512000
# The same bot on DeepSeek (a hosted provider the agent knows: no base URL):
# BOT_SECRETARY_LLM_PROVIDER="deepseek"
# BOT_SECRETARY_LLM_NAME="deepseek"
# BOT_SECRETARY_LLM_MODEL="deepseek-v4-flash-vision-exp"   # the vision variant reads photos and scans; deepseek-chat is text only
# BOT_SECRETARY_LLM_TOKEN_VAR="DEEPSEEK_API_KEY"
# BOT_SECRETARY_LLM_REASONING_FIELD="reasoning_content"
# BOT_SECRETARY_LLM_CONTEXT_WINDOW=512000
# The remaining API balance at the end of every final answer, "(DeepSeek-Guthaben:
# 18.42 USD)": a loopback proxy in front of the provider fetches it with the
# same key (free) and appends it. DeepSeek and Moonshot only.
# BOT_SECRETARY_LLM_BALANCE=true
# Sub-agents (the delegate_task tool) may run on a different endpoint than the
# bot itself — the number of a global LLM_ENDPOINT_n. A bot on an API model
# keeps the analyses of your own mailboxes on the subscription bridge this way:
# BOT_SECRETARY_DELEGATION_ENDPOINT=1            # the bridge; empty = sub-agents inherit the bot's model
# Which of the agent's toolsets a bot gets. Default: the core composite
# (hermes-telegram — web, terminal, files, browser, memory, cron, …). A list of
# toolset names instead composes a smaller set; leaving `terminal` and `file`
# out is how a bot runs without a shell. MCP servers join on their own.
# BOT_GITHUB_TOOLSET="web memory session_search clarify cronjob todo"
# BOT_<KEY>_NAME, _HOSTNAME (<key>.<TUNNEL_ZONE>), _ROLE (bot/roles/<role>.md),
# _TEAMS_CLIENT_ID_VAR / _TEAMS_CLIENT_SECRET_VAR (TEAMS_<KEY>_CLIENT_ID / _SECRET),
# _TOOLSET, _DESCRIPTION all have derived defaults.

# ---------------------------------------------------------------------------
# The assistant, Google side (README 1.11) — the agent's private Gmail account,
# used only when the operator says "privat". Needs gcloud signed in as that
# account and, once, an OAuth Desktop client in the secrets file.
# ---------------------------------------------------------------------------
ASSISTANT_GOOGLE_ENABLED=false
ASSISTANT_GOOGLE_ACCOUNT="agent@example.com"
# Your own Gmail accounts the assistant may READ (Gmail only, read-only scopes).
# One sign-in each, AS that account — the run asks for it (README 1.11).
ASSISTANT_GOOGLE_READ_ACCOUNTS=""                # e.g. "you@gmail.example"
# The filing root in the agent's Google Drive and its worlds — empty: the same
# as Microsoft 365 (ASSISTANT_M365_ROOT_FOLDER / ASSISTANT_M365_WORLDS).
ASSISTANT_GOOGLE_ROOT_FOLDER=""
ASSISTANT_GOOGLE_WORLDS=""
ASSISTANT_GOOGLE_INBOX=""                        # empty = ASSISTANT_M365_INBOX
GOOGLE_PROJECT="my-assistant-project"

# Public pages (home, privacy policy, terms) under assistant.<zone> — what Google
# and Teams ask for before an app may be published (README 1.12).
SITE_ENABLED=true
SITE_OWNER="Acme Ltd"
SITE_CONTACT="agent@example.com"
# SITE_HOSTNAME=assistant.<TUNNEL_ZONE>, SITE_PORT=8081

# ---------------------------------------------------------------------------
# The assistant, GitHub side (README 1.13): github/github-mcp-server, pinned,
# checksum-verified, with a personal access token from the secrets file.
# ---------------------------------------------------------------------------
ASSISTANT_GITHUB_ENABLED=false
# ASSISTANT_GITHUB_TOKEN_VAR=GITHUB_MCP_TOKEN   # name of the token in the secrets file (a classic admin token works too, by choice)
# ASSISTANT_GITHUB_MCP_VERSION=1.12.0
# ASSISTANT_GITHUB_TOOLSETS=context,repos,issues,pull_requests,actions,code_security,discussions,notifications,users,labels
# ASSISTANT_GITHUB_READ_ONLY=false
