# Secrets — copy to config/secrets.conf and fill in. The real file is ignored by
# git and read by the installer as KEY=VALUE lines (never sourced: a value can
# contain anything). Every key below is referenced by name from hermes.conf or
# channels.conf (the *_VAR settings) — the names are the contract, the values
# are yours.
#
# Format: one KEY=VALUE per line, no quotes needed, no spaces around '='.
# Lists are comma-separated.

# -----------------------------------------------------------------------------
# Microsoft Entra / Azure
# -----------------------------------------------------------------------------
# The tenant every Entra app below belongs to.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# The public-client app registration the mail relay and the Microsoft 365
# assistant sign in with (device code). README 1.4.
MAIL_CLIENT_ID=00000000-0000-0000-0000-000000000000

# The Teams bots — one Entra app per bot. Names follow BOT_<KEY>_TEAMS_CLIENT_ID_VAR
# / _CLIENT_SECRET_VAR (default TEAMS_<KEY>_CLIENT_ID / _SECRET). Leave them OUT
# for a new bot: the run creates the app and writes both values here.
# TEAMS_SECRETARY_CLIENT_ID=
# TEAMS_SECRETARY_CLIENT_SECRET=
# TEAMS_SEARCH_CLIENT_ID=
# TEAMS_SEARCH_CLIENT_SECRET=
# TEAMS_NEWS_CLIENT_ID=
# TEAMS_NEWS_CLIENT_SECRET=

# Without a bot list (BOTS empty, single-bot mode) the Teams channel reads
# CHANNEL_TEAMS_CLIENT_ID_VAR / _SECRET_VAR from channels.conf, by default:
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=

# Who may talk to the Teams bots: Entra OBJECT ids of people (not mailboxes),
# comma-separated. Microsoft Entra ID -> Users -> you -> Object ID. README 1.5.
TEAMS_ALLOWED_OBJECT_IDS=00000000-0000-0000-0000-000000000000

# -----------------------------------------------------------------------------
# E-mail
# -----------------------------------------------------------------------------
# WORK mailbox (Exchange Online, through the OAuth relay): the value is the
# relay's local password — any string; the relay authenticates upstream with
# OAuth. PRIVATE mailbox (consumer provider): an app password.
EMAIL_WORK_PASSWORD=change-me
EMAIL_PRIVATE_PASSWORD=change-me

# Addresses allowed to give the agent instructions by mail, comma-separated.
EMAIL_ALLOWED_SENDERS=you@example.com,you.private@example.com

# -----------------------------------------------------------------------------
# Cloudflare (tunnel) — README 1.6
# -----------------------------------------------------------------------------
# Account-owned API token: Account -> Cloudflare Tunnel Edit, Zone -> DNS Edit,
# Zone -> SSL and Certificates Edit (Universal SSL), Zone -> Zone Read.
CF_API_TOKEN=change-me
CF_ACCOUNT_ID=00000000000000000000000000000000

# -----------------------------------------------------------------------------
# Models over a real API (per bot: BOT_<KEY>_LLM_TOKEN_VAR names the key)
# -----------------------------------------------------------------------------
# KIMI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Google — the assistant's private account (README 1.11)
# -----------------------------------------------------------------------------
# OAuth client of type "Desktop app" from the Google Cloud console (Google Auth
# Platform -> Clients), project GOOGLE_PROJECT. Publish the app; in Testing
# status refresh tokens expire after seven days.
GOOGLE_OAUTH_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=change-me

# -----------------------------------------------------------------------------
# Dashboard, GitHub, other channels
# -----------------------------------------------------------------------------
# Password of the dashboard's login (DASHBOARD_PROXY_PASSWORD_VAR).
DASHBOARD_PASSWORD=change-me

# Optional: a GitHub token for release lookups by the devtools module
# (DEVTOOLS_GITHUB_TOKEN_VAR); without it the anonymous 60/h limit applies.
# GITHUB_TOKEN=ghp_...

# The GitHub bot's token (ASSISTANT_GITHUB_TOKEN_VAR): a fine-grained personal access
# token limited to the repositories the bot may see — contents, issues, pull
# requests, actions, security events as needed. README 1.13.
# GITHUB_MCP_TOKEN=github_pat_...

# Only if those channels are enabled in channels.conf:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_IDS=
# WHATSAPP_ALLOWED_SENDERS=
